{
  "name": "onni-monorepo",
  "private": true,
  "description": "Workspace root for Onni Work. Publishes nothing itself — see packages/*.",
  "license": "MIT",
  "author": "DOANTUANIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contract",
    "packages/api-client",
    "packages/work",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run check:pack",
    "build:server": "npm run build -w @onni/work",
    "build:web": "npm run build -w @onni/web",
    "check:pack": "npm run check:pack -w @onni/work",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @onni/work --",
    "dev:web": "npm run dev -w @onni/web --",
    "server-install": "npm run server-install -w @onni/work --",
    "server-deploy": "npm run server-deploy -w @onni/work --",
    "server-uninstall": "npm run server-uninstall -w @onni/work --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "npm run test:unit -w @onni/work",
    "test:package": "npm run test:package -w @onni/work",
    "test:e2e": "sh .ai/scripts/e2e.sh",
    "pretypecheck": "npm run build:server",
    "typecheck": "npm run typecheck:contract && npm run typecheck:client && npm run typecheck:server && npm run typecheck:web",
    "typecheck:client": "npm run typecheck -w @onni/api-client",
    "typecheck:server": "npm run typecheck -w @onni/work",
    "typecheck:web": "npm run typecheck -w @onni/web",
    "typecheck:contract": "npm run typecheck -w @onni/contract"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@e2e-dev/web": "^0.14.0",
    "@types/node": "^20.14.0",
    "ai": "^7.0.0",
    "e2e": "^0.19.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doantuan22/Onni_Work"
  }
}
