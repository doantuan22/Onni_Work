{
  "name": "@onni/work",
  "version": "0.17.0",
  "description": "Local cockpit for running and tracking AI agent tasks in your repo. Uses your logged-in `claude` CLI and `gh` — zero config, zero database.",
  "license": "MIT",
  "author": "DOANTUANIT",
  "private": true,
  "type": "module",
  "bin": {
    "onni": "dist/index.js",
    "onni-cli": "dist/index.js",
    "onni-run": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app-type": "./dist/server/app-type.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web/dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/sync-readme.mjs",
    "build": "tsc",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "tsx src/index.ts",
    "server-install": "tsx src/index.ts server-install",
    "server-deploy": "tsx src/index.ts server-deploy",
    "server-uninstall": "tsx src/index.ts server-uninstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:package": "node --import tsx --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "postbuild": "node scripts/inline-contract.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.6.1",
    "hono": "^4.6.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.7.0",
    "undici": "^6.29.0",
    "ws": "^8.21.1",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@onni/api-client": "^0.17.0",
    "@onni/contract": "^0.17.0",
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doantuan22/Onni_Work",
    "directory": "packages/work"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@napi-rs/keyring": "^2.1.1"
  }
}
